DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOSE_OVERDUE_GRACE_MINUTES=60
DOSE_REMINDER_LEAD_MINUTES=15
WORKER_POLL_SECONDS=60
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Generate a unique, random SECRET_KEY for every non-development deployment.
# Production/test environments reject this placeholder; never copy it into frontend/.env.
